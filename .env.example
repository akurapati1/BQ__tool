# Quickbase
QB_REALMID=yourrealm.quickbase.com
QB_USER_TOKEN=
QB_TABLEID=
PAGE_SIZE=1000

# Google Cloud
BUCKET=my-bucket
PROJECT_NAME=my-gcp-project
GCS_PREFIX=quickbase_exports/
COMPRESS_JSONL=true
# Optional: path to a service-account key; leave empty to use Application Default Credentials
GCP_CREDENTIALS_PATH=

# BigQuery (used with --load-bq)
BQ_DATASET=quickbase
BQ_TABLE=records
